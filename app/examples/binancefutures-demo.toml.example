# Binance USD-M Futures Testnet configuration.
#
# Public market WebSocket (USD-M Testnet). This client connects to /ws and then
# sends SUBSCRIBE requests for trade + diff-depth streams.
public_stream_url = "wss://stream.binancefuture.com/ws"

# Testnet private user-data stream. {listen_key} is replaced at runtime.
private_stream_url = "wss://stream.binancefuture.com/ws/{listen_key}"

# USD-M Futures Testnet REST API.
api_url = "https://testnet.binancefuture.com"

order_prefix = "hfttest"
api_key = ""
secret = ""
