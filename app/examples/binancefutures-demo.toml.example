# Binance USD-M Futures Demo trading configuration.
#
# Public market data does not require authentication. Use the standard production
# USD-M Futures raw WebSocket endpoint for continuous BTCUSDT depth/trade data.
public_stream_url = "wss://fstream.binance.com/ws"

# Demo private user-data stream. {listen_key} is replaced at runtime.
private_stream_url = "wss://demo-fstream.binance.com/ws/{listen_key}"

# Demo REST API for positions/orders/account operations.
api_url = "https://demo-fapi.binance.com"

order_prefix = "hfttest"
api_key = ""
secret = ""
